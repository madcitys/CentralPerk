# Frontend public Supabase values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-public-project.supabase.co
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-public-project-id
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_FORCE_CUSTOMER_DEMO_AUTH=false
NEXT_PUBLIC_USE_SPLIT_SERVICE_DATABASES=true
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# In split database mode the frontend reads member profile/auth data from the
# member project and reads points activity through the gateway/points service.
# You may point the public frontend variables at the member project's anon config:
# NEXT_PUBLIC_SUPABASE_URL=$MEMBER_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY=$MEMBER_SUPABASE_ANON_KEY

# Split database mode for backend services.
USE_SPLIT_SERVICE_DATABASES=true

# Member service database.
MEMBER_SUPABASE_URL=https://your-member-project.supabase.co
MEMBER_SUPABASE_SERVICE_ROLE_KEY=your-member-service-role-key
MEMBER_DATABASE_URL=postgresql://postgres:password@db.your-member-project.supabase.co:5432/postgres
MEMBER_DB_SCHEMA=public

# Segment service database.
SEGMENT_SUPABASE_URL=https://your-segment-project.supabase.co
SEGMENT_SUPABASE_SERVICE_ROLE_KEY=your-segment-service-role-key
SEGMENT_DATABASE_URL=postgresql://postgres:password@db.your-segment-project.supabase.co:5432/postgres
SEGMENT_DB_SCHEMA=public

# Campaign service database.
CAMPAIGN_SUPABASE_URL=https://your-campaign-project.supabase.co
CAMPAIGN_SUPABASE_SERVICE_ROLE_KEY=your-campaign-service-role-key
CAMPAIGN_DATABASE_URL=postgresql://postgres:password@db.your-campaign-project.supabase.co:5432/postgres
CAMPAIGN_DB_SCHEMA=public

# Notification service database.
NOTIFICATION_SUPABASE_URL=https://your-notification-project.supabase.co
NOTIFICATION_SUPABASE_SERVICE_ROLE_KEY=your-notification-service-role-key
NOTIFICATION_DATABASE_URL=postgresql://postgres:password@db.your-notification-project.supabase.co:5432/postgres
NOTIFICATION_DB_SCHEMA=public

# Reward service database.
REWARD_SUPABASE_URL=https://your-reward-project.supabase.co
REWARD_SUPABASE_SERVICE_ROLE_KEY=your-reward-service-role-key
REWARD_DATABASE_URL=postgresql://postgres:password@db.your-reward-project.supabase.co:5432/postgres
REWARD_DB_SCHEMA=public

# Points service database.
POINTS_SUPABASE_URL=https://your-points-project.supabase.co
POINTS_SUPABASE_SERVICE_ROLE_KEY=your-points-service-role-key
POINTS_DATABASE_URL=postgresql://postgres:password@db.your-points-project.supabase.co:5432/postgres
POINTS_DB_SCHEMA=public

# Service URLs for Docker Compose service-to-service traffic.
GATEWAY_URL=http://gateway:4000
MEMBER_SERVICE_URL=http://member-service:4003
SEGMENT_SERVICE_URL=http://segment-service:4004
CAMPAIGN_SERVICE_URL=http://campaign-service:4002
NOTIFICATION_SERVICE_URL=http://notification-service:4005
REWARD_SERVICE_URL=http://reward-service:4006
POINTS_SERVICE_URL=http://points-engine:4001

# Optional local host URLs for browser-to-service testing outside Docker.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_POINTS_ENGINE_URL=http://localhost:4001
NEXT_PUBLIC_CAMPAIGN_SERVICE_URL=http://localhost:4002
