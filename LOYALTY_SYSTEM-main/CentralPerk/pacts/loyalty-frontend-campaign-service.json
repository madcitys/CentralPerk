{
  "consumer": {
    "name": "loyalty-frontend"
  },
  "interactions": [
    {
      "description": "a budget status request from the loyalty frontend",
      "providerStates": [
        {
          "name": "a campaign budget status is available"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/campaigns/cmp-budget/budget-status"
      },
      "response": {
        "body": {
          "budgetStatus": {
            "budgetLimit": 120,
            "budgetRemaining": 120,
            "budgetSpent": 0,
            "campaignId": "cmp-budget",
            "status": "active",
            "utilizationPercent": 0
          },
          "ok": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.budgetStatus.budgetLimit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.budgetStatus.budgetRemaining": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.budgetStatus.budgetSpent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.budgetStatus.campaignId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.budgetStatus.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.budgetStatus.utilizationPercent": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a campaign publish request from the loyalty frontend",
      "providerStates": [
        {
          "name": "a draft campaign can be published"
        }
      ],
      "request": {
        "body": {
          "queueNotifications": false
        },
        "headers": {
          "Content-Type": "application/json",
          "x-role": "admin"
        },
        "method": "PATCH",
        "path": "/campaigns/cmp-publish/publish"
      },
      "response": {
        "body": {
          "campaign": {
            "campaignCode": "CMP-PUBLISH",
            "campaignName": "Publishable Campaign",
            "id": "cmp-publish",
            "status": "active"
          },
          "notificationsQueued": 0,
          "ok": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.campaign.campaignCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaign.campaignName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaign.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaign.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.notificationsQueued": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a campaign save request from the loyalty frontend",
      "providerStates": [
        {
          "name": "a campaign can be created"
        }
      ],
      "request": {
        "body": {
          "campaignCode": "CMP-CREATE",
          "campaignName": "Created Campaign",
          "campaignType": "multiplier_event",
          "endsAt": "2026-12-31T23:59:59.000Z",
          "startsAt": "2026-01-01T00:00:00.000Z"
        },
        "headers": {
          "Content-Type": "application/json",
          "x-role": "admin"
        },
        "method": "POST",
        "path": "/campaigns"
      },
      "response": {
        "body": {
          "campaign": {
            "campaignCode": "CMP-CREATE",
            "campaignName": "Created Campaign",
            "id": "cmp-created",
            "status": "draft"
          },
          "ok": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.campaign.campaignCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaign.campaignName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaign.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaign.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a campaigns list request from the loyalty frontend",
      "providerStates": [
        {
          "name": "campaign collection exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/campaigns"
      },
      "response": {
        "body": {
          "campaigns": [
            {
              "campaignCode": "CMP-LIST",
              "campaignName": "Collection Campaign",
              "campaignType": "multiplier_event",
              "id": "cmp-list",
              "status": "draft"
            }
          ],
          "ok": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.campaigns[0].campaignCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaigns[0].campaignName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaigns[0].campaignType": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaigns[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaigns[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "an active campaigns request from the loyalty frontend",
      "providerStates": [
        {
          "name": "an active campaign is available"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/campaigns/active"
      },
      "response": {
        "body": {
          "campaigns": [
            {
              "campaignCode": "CMP-ACTIVE",
              "campaignName": "Active Campaign",
              "campaignType": "multiplier_event",
              "id": "cmp-active",
              "multiplier": 2,
              "status": "active"
            }
          ],
          "ok": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.campaigns[0].campaignCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaigns[0].campaignName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaigns[0].campaignType": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaigns[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.campaigns[0].multiplier": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.campaigns[0].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.3.0"
    },
    "pactRust": {
      "ffi": "0.5.3",
      "models": "1.3.9"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "campaign-service"
  }
}