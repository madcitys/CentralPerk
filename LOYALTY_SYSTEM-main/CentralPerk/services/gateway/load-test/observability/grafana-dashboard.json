      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(k6_http_req_failed{testid=~\"$testid\"}) / clamp_min(sum(k6_http_reqs{testid=~\"$testid\"}), 1)",
          "legendFormat": "error_rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error Rate",
      "type": "stat"
