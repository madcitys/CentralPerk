{
    "name": "@figma/my-make-file",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "build": "next build",
        "dev": "node scripts/next-dev-inproc.cjs",
        "dev:frontend": "node scripts/next-dev-inproc.cjs",
        "setup:backend": "npm --prefix backend install",
        "dev:backend": "npm --prefix backend run start:dev",
        "build:backend": "npm --prefix backend run build",
        "start:backend": "npm --prefix backend run start",
        "build:all": "npm run build && npm run build:backend",
        "health": "powershell -NoProfile -Command \"Invoke-RestMethod http://localhost:4000/health | ConvertTo-Json -Depth 6\"",
        "setup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-local-stack.ps1",
        "local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local-stack.ps1 -StopExisting",
        "qa": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-local-stack.ps1",
        "test:contracts": "node --import tsx --test tests/contracts/points.consumer.contract.test.ts tests/contracts/campaign.consumer.contract.test.ts",
        "test:contracts:break:generate": "node --import tsx --test tests/contracts/points.breaking.contract.test.ts",
        "test:contracts:break": "node scripts/pact-breaking-check.mjs",
        "verify:contracts:points": "npm --prefix services/points-engine run verify:pact",
        "verify:contracts:campaign": "npm --prefix services/campaign-service run verify:pact",
        "contracts:publish": "node scripts/pact-publish.mjs",
        "contracts:can-i-deploy": "node scripts/pact-can-i-deploy.mjs",
        "loadtest:baseline": "powershell -NoProfile -ExecutionPolicy Bypass -File ./services/gateway/load-test/run-baseline.ps1",
        "loadtest:grafana": "powershell -NoProfile -ExecutionPolicy Bypass -File ./services/gateway/load-test/run-grafana-output.ps1",
        "preserver": "next build",
        "prestart": "next build",
        "server": "next start --hostname 0.0.0.0 --port 3000",
        "start": "next start --hostname 0.0.0.0 --port 3000"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "1.2.3",
        "@radix-ui/react-alert-dialog": "1.1.6",
        "@radix-ui/react-aspect-ratio": "1.1.2",
        "@radix-ui/react-avatar": "1.1.3",
        "@radix-ui/react-checkbox": "1.1.4",
        "@radix-ui/react-collapsible": "1.1.3",
        "@radix-ui/react-context-menu": "2.2.6",
        "@radix-ui/react-dialog": "1.1.6",
        "@radix-ui/react-dropdown-menu": "2.1.6",
        "@radix-ui/react-hover-card": "1.1.6",
        "@radix-ui/react-label": "2.1.2",
        "@radix-ui/react-menubar": "1.1.6",
        "@radix-ui/react-navigation-menu": "1.2.5",
        "@radix-ui/react-popover": "1.1.6",
        "@radix-ui/react-progress": "1.1.2",
        "@radix-ui/react-radio-group": "1.2.3",
        "@radix-ui/react-scroll-area": "1.2.3",
        "@radix-ui/react-select": "2.1.6",
        "@radix-ui/react-separator": "1.1.2",
        "@radix-ui/react-slider": "1.2.3",
        "@radix-ui/react-slot": "1.1.2",
        "@radix-ui/react-switch": "1.1.3",
        "@radix-ui/react-tabs": "1.1.3",
        "@radix-ui/react-toggle": "1.1.2",
        "@radix-ui/react-toggle-group": "1.1.2",
        "@radix-ui/react-tooltip": "1.1.8",
        "@supabase/supabase-js": "^2.97.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "1.1.1",
        "embla-carousel-react": "8.6.0",
        "input-otp": "1.4.2",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.7",
        "lucide-react": "0.487.0",
        "motion": "12.23.24",
        "next": "^16.2.4",
        "next-themes": "0.4.6",
        "react": "18.3.1",
        "react-day-picker": "8.10.1",
        "react-dom": "18.3.1",
        "react-hook-form": "7.55.0",
        "react-resizable-panels": "2.1.7",
        "react-router-dom": "^7.13.1",
        "recharts": "2.15.2",
        "sonner": "2.0.3",
        "tailwind-merge": "3.2.0",
        "tw-animate-css": "1.3.8",
        "vaul": "1.1.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@pact-foundation/pact": "^16.3.0",
        "@pact-foundation/pact-cli": "^16.1.4",
        "@tailwindcss/postcss": "^4.1.12",
        "@types/node": "^25.5.2",
        "@types/react": "19.2.14",
        "tailwindcss": "4.1.12",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "description": "This is a code bundle for Design Log. The original project is available at https://www.figma.com/design/Gp9tJFj47Xx36LdY2RUXRA/Design-Log.",
    "main": "index.js",
    "keywords": [],
