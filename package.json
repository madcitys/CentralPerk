
{
  "name": "centralperk-workspace",
  "private": true,
  "scripts": {
    "install:frontend": "npm --prefix ./centralperk-frontend install",
    "install:backend": "npm --prefix ./centralperk-backend install",
    "dev": "npm --prefix ./centralperk-frontend run dev",
    "frontend": "npm --prefix ./centralperk-frontend run dev",
    "backend": "npm --prefix ./centralperk-backend run build",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix ./centralperk-frontend run build",
    "build:backend": "npm --prefix ./centralperk-backend run build",
    "build:services": "npm run build:backend",
    "validate:split-dbs": "npm --prefix ./centralperk-backend run validate:split-dbs",
    "start:frontend": "npm --prefix ./centralperk-frontend run start",
    "start:backend": "npm --prefix ./centralperk-backend run start:help",
    "start:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-local.ps1",
    "restart:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1 -Build",
    "preview": "npm --prefix ./centralperk-frontend run start",
    "postinstall": "npm run install:frontend && npm run install:backend"
  }
}
