{
  "info": {
    "_postman_id": "56fd4414-e21d-44e1-9e43-system3api",
    "name": "System 3 Loyalty API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://127.0.0.1:4000"
    },
    {
      "key": "frontendUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = Date.now();",
          "const normalizeLocalUrl = (value, fallback) => String(value || fallback).replace('http://localhost:', 'http://127.0.0.1:').replace(/\\/+$/, '');",
          "const gatewayUrl = normalizeLocalUrl(pm.environment.get('gatewayUrl') || pm.collectionVariables.get('gatewayUrl'), 'http://127.0.0.1:4000');",
          "const frontendUrl = normalizeLocalUrl(pm.environment.get('frontendUrl') || pm.collectionVariables.get('frontendUrl'), 'http://127.0.0.1:3000');",
          "pm.environment.set('gatewayUrl', gatewayUrl);",
          "pm.environment.set('baseUrl', gatewayUrl);",
          "pm.environment.set('frontendUrl', frontendUrl);",
          "const setIfValue = (key, value) => {",
          "  if (value !== undefined && value !== null && String(value).trim() !== '') pm.environment.set(key, String(value));",
          "};",
          "const stamp = String(now);",
          "if (!pm.environment.get('transactionRef')) setIfValue('transactionRef', `POS-${stamp}`);",
          "if (!pm.environment.get('eventId')) setIfValue('eventId', `EVT-${stamp}`);",
          "if (!pm.environment.get('partnerOrderId')) setIfValue('partnerOrderId', `ORDER-${stamp}`);",
          "if (!pm.environment.get('month')) setIfValue('month', new Date().toISOString().slice(0, 7));",
          "if (!pm.environment.get('settlementMonth')) setIfValue('settlementMonth', pm.environment.get('month'));",
          "if (!pm.environment.get('refereeEmail')) setIfValue('refereeEmail', `friend+${stamp}@example.com`);",
          "const contextIsFresh = now - Number(pm.environment.get('contextLoadedAt') || 0) < 30000 && pm.environment.get('memberId') && pm.environment.get('campaignId') && pm.environment.get('rewardId') && pm.environment.get('partnerId');",
          "if (!contextIsFresh) {",
          "  let pending = 5;",
          "  const done = () => {",
          "    pending -= 1;",
          "    if (pending === 0) pm.environment.set('contextLoadedAt', String(Date.now()));",
          "  };",
          "  const requestJson = (path, apply) => {",
          "    pm.sendRequest({ url: `${gatewayUrl}${path}`, method: 'GET', header: { Accept: 'application/json' } }, (err, res) => {",
          "      try {",
          "        if (!err && res && res.code < 400) apply(res.json());",
          "      } catch (error) {}",
          "      done();",
          "    });",
          "  };",
          "  requestJson('/members?limit=1', (json) => {",
          "    const member = Array.isArray(json.members) ? json.members[0] : null;",
          "    if (member) {",
          "      setIfValue('memberId', member.memberNumber || member.member_number || member.memberId || member.id);",
          "      setIfValue('memberEmail', member.email);",
          "    }",
          "  });",
          "  requestJson('/campaigns', (json) => {",
          "    const campaigns = Array.isArray(json.campaigns) ? json.campaigns.filter((row) => row && row.id) : [];",
          "    const campaign = campaigns.find((row) => row.status === 'draft') || campaigns.find((row) => row.status === 'active') || campaigns[0];",
          "    if (campaign) {",
          "      setIfValue('campaignId', campaign.id);",
          "      setIfValue('campaignCode', campaign.campaignCode || campaign.campaign_code);",
          "    }",
          "  });",
          "  requestJson('/rewards', (json) => {",
          "    const rewards = Array.isArray(json.rewards) ? json.rewards : [];",
          "    const reward = rewards.find((row) => row && (row.is_active !== false && row.active !== false)) || rewards[0];",
          "    if (reward) {",
          "      setIfValue('rewardId', reward.reward_catalog_id || reward.rewardCatalogId || reward.reward_id || reward.id);",
          "      setIfValue('rewardCategory', reward.category);",
          "      setIfValue('rewardSearch', String(reward.name || '').split(' ')[0] || 'coffee');",
          "    }",
          "  });",
          "  requestJson('/partners/dashboard', (json) => {",
          "    const rows = Array.isArray(json.partners) ? json.partners : [];",
          "    const row = rows.find((entry) => entry.partner && entry.partner.isActive !== false) || rows[0];",
          "    if (row && row.partner) setIfValue('partnerId', row.partner.id);",
          "  });",
          "  requestJson('/notifications?limit=1', (json) => {",
          "    const notification = Array.isArray(json.notifications) ? json.notifications[0] : null;",
          "    if (notification) setIfValue('notificationId', notification.id);",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const contentType = (pm.response.headers.get('Content-Type') || '').toLowerCase();",
          "if (contentType.includes('application/pdf')) {",
          "  pm.test('PDF response', function () { pm.expect(true).to.eql(true); });",
          "  return;",
          "}",
          "const text = pm.response.text();",
          "const markers = ['<!DOCTYPE html', '<html', '__NEXT_DATA__', '/_next/static', '__next/static'];",
          "const hit = markers.find((m) => text.includes(m));",
          "pm.test('Response is backend JSON (not Next HTML)', function () {",
          "  if (hit) {",
          "    pm.expect.fail('Wrong target: request hit Next.js frontend instead of backend. Marker: ' + hit);",
          "  }",
          "});",
          "let json = null;",
          "try { json = pm.response.json(); } catch (error) {}",
          "const setIfValue = (key, value) => {",
          "  if (value !== undefined && value !== null && String(value).trim() !== '') pm.environment.set(key, String(value));",
          "};",
          "if (json) {",
          "  const member = json.member || json.profile || (Array.isArray(json.members) ? json.members[0] : null);",
          "  if (member) {",
          "    setIfValue('memberId', member.memberNumber || member.member_number || member.memberId || member.id || member.member_id);",
          "    setIfValue('memberEmail', member.email);",
          "  }",
          "  const campaign = json.campaign || (Array.isArray(json.campaigns) ? json.campaigns[0] : null);",
          "  if (campaign) {",
          "    setIfValue('campaignId', campaign.id || campaign.campaignId || campaign.campaign_id);",
          "    setIfValue('campaignCode', campaign.campaignCode || campaign.campaign_code);",
          "  }",
          "  const reward = json.reward || (Array.isArray(json.rewards) ? json.rewards[0] : null);",
          "  if (reward) {",
          "    setIfValue('rewardId', reward.reward_catalog_id || reward.rewardCatalogId || reward.reward_id || reward.id);",
          "    setIfValue('rewardCategory', reward.category);",
          "  }",
          "  const partnerRow = json.partner || (Array.isArray(json.partners) ? json.partners[0] && json.partners[0].partner : null);",
          "  if (partnerRow) setIfValue('partnerId', partnerRow.id || partnerRow.partnerId);",
          "  const notification = json.notification || (Array.isArray(json.notifications) ? json.notifications[0] : null);",
          "  if (notification) setIfValue('notificationId', notification.id);",
          "  const referral = json.referral || (Array.isArray(json.referrals) ? json.referrals[0] : null);",
          "  if (referral) setIfValue('referralId', referral.id);",
          "  if (json.transaction && json.transaction.reference) setIfValue('transactionRef', json.transaction.reference);",
          "}"
        ]
      }
    }
  ],
