    },
    {
      "name": "07 Referrals",
      "item": [
        {
          "name": "Create Referral Invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/referrals",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referrerMemberId\": \"{{memberId}}\",\n  \"refereeEmail\": \"{{refereeEmail}}\",\n  \"notify\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('refereeEmail', `friend+${Date.now()}@example.com`);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Member Referrals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/referrals?memberId={{memberId}}"
          }
        },
        {
          "name": "Referral Invite Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{notificationServiceUrl}}/notifications?channel=email&limit=20"
          }
        }
      ]
    }
  ]
}
