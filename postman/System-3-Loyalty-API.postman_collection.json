            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberIdentifier\": \"{{memberId}}\",\n  \"fallbackEmail\": \"{{memberEmail}}\",\n  \"points\": 625,\n  \"transactionType\": \"PURCHASE\",\n  \"transactionRef\": \"POS-{{$timestamp}}\",\n  \"reason\": \"POS purchase test\",\n  \"amountSpent\": 500,\n  \"productCode\": \"SKU-001\",\n  \"productCategory\": \"Beverage\"\n}",
