# Frontend public Supabase values. These are safe to expose to the browser.
NEXT_PUBLIC_SCM_FRONTEND_SUPABASE_URL=https://your-public-project.supabase.co
NEXT_PUBLIC_SCM_FRONTEND_SUPABASE_PROJECT_ID=your-public-project-id
NEXT_PUBLIC_SCM_FRONTEND_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
NEXT_PUBLIC_SCM_FRONTEND_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SCM_FRONTEND_ENABLE_DEMO_AUTH=false
NEXT_PUBLIC_SCM_FRONTEND_FORCE_CUSTOMER_DEMO_AUTH=false
NEXT_PUBLIC_SCM_FRONTEND_ENABLE_DEMO_PROFILE_BOOTSTRAP=false
NEXT_PUBLIC_SCM_FRONTEND_USE_SPLIT_SERVICE_DATABASES=true
SCM_MEMBER_USE_SPLIT_SERVICE_DATABASES=true
SCM_SEGMENT_USE_SPLIT_SERVICE_DATABASES=true
SCM_CAMPAIGN_USE_SPLIT_SERVICE_DATABASES=true
SCM_NOTIFICATION_USE_SPLIT_SERVICE_DATABASES=true
SCM_REWARD_USE_SPLIT_SERVICE_DATABASES=true
SCM_POINTS_USE_SPLIT_SERVICE_DATABASES=true
NEXT_PUBLIC_SCM_GATEWAY_URL=http://localhost:3011

# In split database mode the frontend reads member profile/auth data from the
# member project and reads points activity through the gateway/points service.
# You may point the public frontend variables at the member project's anon config:
# NEXT_PUBLIC_SCM_FRONTEND_SUPABASE_URL=$SCM_MEMBER_SUPABASE_URL
# NEXT_PUBLIC_SCM_FRONTEND_SUPABASE_ANON_KEY=$SCM_MEMBER_SUPABASE_ANON_KEY

# Split database mode for backend services.
SCM_FRONTEND_USE_SPLIT_SERVICE_DATABASES=true

# Member service database.
SCM_MEMBER_SUPABASE_URL=https://your-member-project.supabase.co
SCM_MEMBER_SUPABASE_ANON_KEY=your-member-anon-key
SCM_MEMBER_SUPABASE_SERVICE_ROLE_KEY=your-member-service-role-key
SCM_MEMBER_DATABASE_URL=postgresql://postgres:password@db.your-member-project.supabase.co:5432/postgres
SCM_MEMBER_DB_SCHEMA=public

# Segment service database.
SCM_SEGMENT_SUPABASE_URL=https://your-segment-project.supabase.co
SCM_SEGMENT_SUPABASE_ANON_KEY=your-segment-anon-key
SCM_SEGMENT_SUPABASE_SERVICE_ROLE_KEY=your-segment-service-role-key
SCM_SEGMENT_DATABASE_URL=postgresql://postgres:password@db.your-segment-project.supabase.co:5432/postgres
SCM_SEGMENT_DB_SCHEMA=public

# Campaign service database.
SCM_CAMPAIGN_SUPABASE_URL=https://your-campaign-project.supabase.co
SCM_CAMPAIGN_SUPABASE_ANON_KEY=your-campaign-anon-key
SCM_CAMPAIGN_SUPABASE_SERVICE_ROLE_KEY=your-campaign-service-role-key
SCM_CAMPAIGN_DATABASE_URL=postgresql://postgres:password@db.your-campaign-project.supabase.co:5432/postgres
SCM_CAMPAIGN_DB_SCHEMA=public

# Notification service database.
SCM_NOTIFICATION_SUPABASE_URL=https://your-notification-project.supabase.co
SCM_NOTIFICATION_SUPABASE_ANON_KEY=your-notification-anon-key
SCM_NOTIFICATION_SUPABASE_SERVICE_ROLE_KEY=your-notification-service-role-key
SCM_NOTIFICATION_DATABASE_URL=postgresql://postgres:password@db.your-notification-project.supabase.co:5432/postgres
SCM_NOTIFICATION_DB_SCHEMA=public

# Reward service database.
SCM_REWARD_SUPABASE_URL=https://your-reward-project.supabase.co
SCM_REWARD_SUPABASE_ANON_KEY=your-reward-anon-key
SCM_REWARD_SUPABASE_SERVICE_ROLE_KEY=your-reward-service-role-key
SCM_REWARD_DATABASE_URL=postgresql://postgres:password@db.your-reward-project.supabase.co:5432/postgres
SCM_REWARD_DB_SCHEMA=public

# Points service database.
SCM_POINTS_SUPABASE_URL=https://your-points-project.supabase.co
SCM_POINTS_SUPABASE_ANON_KEY=your-points-anon-key
SCM_POINTS_SUPABASE_SERVICE_ROLE_KEY=your-points-service-role-key
SCM_POINTS_DATABASE_URL=postgresql://postgres:password@db.your-points-project.supabase.co:5432/postgres
SCM_POINTS_DB_SCHEMA=public

# Service URLs for Docker Compose service-to-service traffic.
SCM_GATEWAY_URL=http://gateway:3011
SCM_MEMBER_SERVICE_URL=http://member-service:3012
SCM_SEGMENT_SERVICE_URL=http://segment-service:3013
SCM_CAMPAIGN_SERVICE_URL=http://campaign-service:3014
SCM_NOTIFICATION_SERVICE_URL=http://notification-service:3015
SCM_REWARD_SERVICE_URL=http://reward-service:3016
SCM_POINTS_SERVICE_URL=http://points-engine:3017

# Optional local host URLs for browser-to-service testing outside Docker.
NEXT_PUBLIC_SCM_POINTS_ENGINE_URL=http://localhost:3017
NEXT_PUBLIC_SCM_CAMPAIGN_SERVICE_URL=http://localhost:3014