{
  "name": "campaign-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/tests/unit.test.js dist/tests/integration.test.js",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=lcov --check-coverage --lines 70 --functions 70 node --test dist/tests/unit.test.js dist/tests/integration.test.js",
    "test:db:seed": "npm run build && node dist/testing/seed-test-db.js",
    "test:db:teardown": "npm run build && node dist/testing/teardown-test-db.js",
    "verify": "npm run build && node scripts/verify.js",
    "verify:pact": "npm run build && node scripts/verify-pact.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "dotenv": "^16.6.1",
    "fastify": "^4.27.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
